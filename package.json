{
  "name": "tum-mile",
  "version": "0.1.0",
  "private": true,
  "description": "Tum Mile — privacy-first dating app",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:frontend\"",
    "dev:server": "cd server && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:server && npm run build:frontend",
    "build:server": "cd server && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "test": "cd server && npm test && cd ../frontend && npm test && cd .. && npm run check:no-em-dash",
    "check:no-em-dash": "node scripts/check-no-em-dash.mjs",
    "typecheck": "npm run typecheck:server && npm run typecheck:frontend",
    "typecheck:server": "cd server && npx tsc --noEmit",
    "typecheck:frontend": "cd frontend && npx tsc --noEmit",
    "lint": "npm run lint:server && npm run lint:frontend",
    "lint:server": "cd server && npx eslint src/",
    "lint:frontend": "cd frontend && npx eslint src/"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5.7.0"
  }
}