# ─── Database ───
DATABASE_URL=postgres://tummile:REPLACE_ME@localhost:5432/tummile

# ─── Server ───
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ─── Session ───
SESSION_COOKIE_NAME=tum_mile_session
SESSION_SECRET=replace-me-with-64-hex-chars-in-production
SESSION_IDLE_TIMEOUT_MS=86400000
SESSION_ABSOLUTE_TIMEOUT_MS=2592000000

# ─── Email ───
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Tum Mile <hello@tummile.in>"
EMAIL_MAGIC_LINK_BASE_URL=http://localhost:5173/verify

# ─── Object Storage ───
STORAGE_MODE=local
STORAGE_LOCAL_DIR=./dev-media
# S3 config (used when STORAGE_MODE=s3):
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_BUCKET=tummile_photos
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ─── Admin (pre-provisioned) ───
ADMIN_EMAIL=admin@tummile.in
ADMIN_PASSWORD_HASH=replace-me-in-production-argon2id-hash

# ─── Rate Limits (requests per window) ───
RATE_LIMIT_MAGIC_LINK=3
RATE_LIMIT_MAGIC_LINK_WINDOW_MS=3600000
RATE_LIMIT_VERIFY=10
RATE_LIMIT_VERIFY_WINDOW_MS=900000
RATE_LIMIT_DISCOVERY=30
RATE_LIMIT_DISCOVERY_WINDOW_MS=60000
RATE_LIMIT_LIKES=20
RATE_LIMIT_LIKES_WINDOW_MS=3600000
RATE_LIMIT_MESSAGE=40
RATE_LIMIT_MESSAGE_WINDOW_MS=3600000
RATE_LIMIT_REPORT=5
RATE_LIMIT_REPORT_WINDOW_MS=3600000
RATE_LIMIT_PHOTO_UPLOAD=10
RATE_LIMIT_PHOTO_UPLOAD_WINDOW_MS=3600000